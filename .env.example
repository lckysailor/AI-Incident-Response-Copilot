# LiveKit Cloud or Self-Hosted Server Credentials
# Get free credentials at: https://cloud.livekit.io
LIVEKIT_URL=wss://<your-project-subdomain>.livekit.cloud
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>

# AI Provider API Keys
# LLM
OPENAI_API_KEY=sk-...

# Speech-To-Text (STT)
DEEPGRAM_API_KEY=...

# Text-To-Speech (TTS)
CARTESIA_API_KEY=...
ELEVENLABS_API_KEY=...

# (Optional) Multimodal / Alternative LLM providers
ANTHROPIC_API_KEY=...
GOOGLE_API_KEY=...
